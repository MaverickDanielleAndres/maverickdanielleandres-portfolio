# ─────────────────────────────────────────────────────────────────────
# Server-side environment variables for the Maverick portfolio.
# Copy this file to `.env.local` and fill in real values. NEVER commit
# `.env.local` or any file containing real secrets to source control.
# ─────────────────────────────────────────────────────────────────────

# ── Resend (used by /api/contact and /api/project-inquiry) ───────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
PROJECT_INQUIRY_EMAIL=

# ── Google Gemini (used by /api/portfolio-chat) ──────────────────────
# Get a key from https://aistudio.google.com/apikey
# The key is ONLY read on the server. It is never exposed to the browser.
GEMINI_API_KEY=

# Model selection. The portfolio assistant prefers a fast, low-cost
# "flash-lite" tier for instant responses. If the primary model fails to
# produce a first byte within 20s, the server retries once with the
# fallback model.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash